# Platform settings - no secrets here, this file is committed.

SANDBOX=aws1                      # the multicloud-k8s-labs sandbox the platform runs in
LABS_DIR=../multicloud-k8s-labs   # where multicloud-k8s-labs lives (relative to this folder)

# Where you pushed this folder. Argo CD pulls everything from here, so it must
# be reachable without credentials (a public repo). If you change it, run
# ./set-repo.sh <new url> so every manifest points to the same place.
REPO_URL=https://github.com/vjrajendran/k8s-platform-lab.git
REVISION=main
